# Server-only Neon pooled connection URL. Never prefix this key with NEXT_PUBLIC_.
DATABASE_URL=

# At least 32 random bytes, encoded as a secret string. Used to sign guest household cookies.
HOUSEHOLD_SESSION_SECRET=

# Server-only AI provider credential. The app disables AI assistance when this is absent.
GROQ_API_KEY=
NEXT_PUBLIC_GROQ_MODEL=openai/gpt-oss-120b
